# Modelo das variáveis de ambiente do projeto.
# Copie este arquivo para `.env` e ajuste os valores:
#     cp .env.example .env
#
# O `.env` NÃO é versionado (está no .gitignore); este exemplo é, para
# documentar quais variáveis a aplicação exige.

# URL de conexão com o banco (obrigatória — sem valor padrão no Settings,
# então a aplicação e o Alembic falham na inicialização se ela faltar).
# SQLite local (usado no estudo):
DATABASE_URL='sqlite:///database.db'
# Exemplo com Postgres:
# DATABASE_URL='postgresql+psycopg://usuario:senha@localhost:5432/nome_do_banco'
